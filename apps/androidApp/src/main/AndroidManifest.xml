<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Data lives on the device; the network is only used to sync directly
         with another device on the same local network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- mDNS: multicast has to be explicitly enabled, and from Android 13
         service discovery needs NEARBY_WIFI_DEVICES. Declared neverForLocation
         because this genuinely isn't used to work out where anyone is. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="tiramisu" />

    <!-- Only for scanning a pairing QR. Requested at the moment you tap "Scan",
         never at launch, and the app is fully usable without it. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Renewal reminders. Asked for the first time reminders are switched on,
         never at launch, and everything else works without it.

         RECEIVE_BOOT_COMPLETED is needed because Android drops every scheduled
         alarm on restart: without it, reminders would stop dead the first time
         the phone was turned off and nobody would find out until a renewal was
         missed. No exact-alarm permission is requested — a reminder that lands
         within a few minutes of nine o'clock is entirely fine. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".android.SubTrackerApp"
        android:allowBackup="true"
        android:label="SubTracker"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.SubTracker">

        <activity
            android:name=".android.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Not exported: only this app's own alarm ever fires it. -->
        <receiver
            android:name=".android.ReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".android.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- Some manufacturers send this instead after an update. -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
